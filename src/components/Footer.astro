---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide inner">
    <p class="left">
      <span>© {year} {site.name}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span class="muted">Built with Astro, hosted on GitHub Pages</span>
    </p>
    <ul class="links">
      <li><a href={`mailto:${site.email}`}>Email</a></li>
      <li><a href={site.links.github} rel="me">GitHub</a></li>
      <li><a href={site.links.linkedin} rel="me">LinkedIn</a></li>
      <li><a href={site.links.medium} rel="me">Medium</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    margin-top: 6rem;
    font-size: 0.88rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 2rem;
  }

  .left {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .sep {
    color: var(--text-faint);
  }

  .links {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent-text);
  }
</style>
