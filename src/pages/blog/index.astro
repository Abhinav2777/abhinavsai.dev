---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base
  title="Writing"
  description="Technical case studies on backend engineering, distributed systems and security, written up with the actual evidence."
  type="website"
>
  <section class="container container--wide block">
    <SectionHeading index="00" title="Writing" id="writing" />
    <p class="lede intro">
      Case studies from the backend and security work I do, written with the evidence attached — real numbers,
      real trade-offs, and what stayed unresolved.
    </p>
    <div class="posts">
      {
        posts.map((post) => (
          <a class="post-card" href={`/blog/${post.id}`}>
            <p class="eyebrow">
              {post.data.categories.join(' · ')} · {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h3>{post.data.title}</h3>
            <p class="muted">{post.data.excerpt}</p>
            <ul class="chips">
              {post.data.tags.map((t) => <li class="chip">{t}</li>)}
            </ul>
            <span class="more">
              Read the case study <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .block {
    padding-top: clamp(3rem, 8vw, 5rem);
    padding-bottom: 4rem;
  }

  .intro {
    max-width: var(--measure);
    margin-bottom: 2.5rem;
  }

  .posts {
    display: grid;
    gap: 1.25rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--bg-raised);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .post-card:hover {
    color: inherit;
    border-color: var(--rule-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .post-card h3 {
    font-size: 1.35rem;
    margin: 0.5rem 0 0.8rem;
  }

  .post-card .muted {
    font-size: 0.97rem;
  }

  .more {
    margin-top: auto;
    padding-top: 1.2rem;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--accent-text);
  }

  .post-card .chips {
    margin-top: 0.2rem;
  }
</style>
