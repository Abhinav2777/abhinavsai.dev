---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';

const stats = [
  { value: '~12k', label: 'restaurant stores in 17 markets served by services I own' },
  { value: '~75%', label: 'lower cache cost after leading a move to ElastiCache Serverless' },
  { value: '100/100', label: 'rounds with exactly one winner, 16 requests racing for the same move' },
  { value: '40 / 0', label: 'live games carried through a rolling deploy / games lost' },
];

const work = [
  {
    href: '/work/chess-platform',
    kind: 'Side project · 2026',
    title: 'Real-time multiplayer chess platform',
    summary:
      'A server-authoritative clock that cannot drift, exactly-once moves without a distributed lock, and games that survive the server they are on being replaced mid-move. Deployed to AWS with Terraform, run on Kubernetes, load-tested and failure-drilled, with every number written up.',
    tags: ['Java 25', 'Spring Boot 4', 'PostgreSQL', 'Valkey', 'WebSockets', 'SQS', 'ECS Fargate', 'Kubernetes', 'k6'],
    image: '/media/game.webp',
    alt: 'A game in progress: the board, both clocks and the move list',
  },
  {
    href: '/work/valkey-migration',
    kind: 'Production · Khumbu Systems',
    title: 'Redis + Lettuce to Valkey Serverless + GLIDE',
    summary:
      'Leading the migration of a provisioned Redis cache to ElastiCache Serverless: a custom Spring cache on a client Spring does not support, a shutdown-ordering bug that only appeared during deploys, and the gzip change that cut ECPU usage by 44%.',
    tags: ['ElastiCache Serverless', 'Valkey GLIDE', 'Spring Cache', 'DynamoDB Streams', 'SQS'],
  },
];

const experience = [
  'Design and own the order, cancellation, pricing, menu-sync and store-sync services that connect Uber Eats and RBI’s apps to the point-of-sale systems of Burger King, Popeyes, Tim Hortons, Chipotle and Wingstop.',
  'Daily: 60k quotes, 10k orders, 40k menu syncs and 123k store-status syncs, peaking at 100 requests per second.',
  'Idempotent SQS consumers keyed on correlation ID and queue name absorb partner retries and redeliveries; health checks across Valkey, SQS, S3 and DynamoDB drive disaster-recovery failover between regions.',
  'Cut heavy menu processing from over 70 s to under 20 s; upgraded every backend service to Spring Boot 3 in one week with zero rollbacks; automated rollouts that onboarded 10,000+ stores across EMEA, APAC and the US.',
];
---

<Base>
  <section class="hero container container--wide">
    <div class="hero-text">
    <p class="eyebrow">{site.role} · {site.location}</p>
    <h1>I build backend systems that stay correct when things go wrong.</h1>
    <p class="lede">
      Since 2024 I have built the services at Khumbu Systems that connect delivery and ordering apps to the
      point-of-sale systems of about 12,000 restaurants. On the side I built a real-time multiplayer chess
      platform to go deeper on concurrency and failure, then spent as long trying to break it as building it.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href="/work/chess-platform">Read the chess case study <span aria-hidden="true">→</span></a>
      <a class="btn" href={site.cv}>CV <span class="muted">(PDF)</span></a>
      <a class="btn" href={site.links.github} rel="me">GitHub</a>
    </div>
    </div>
    <img
      class="portrait"
      src="/media/portrait-640.webp"
      srcset="/media/portrait-320.webp 320w, /media/portrait-640.webp 640w"
      sizes="(max-width: 760px) 96px, 280px"
      width="640"
      height="640"
      alt={`Portrait of ${site.name}`}
      fetchpriority="high"
    />
  </section>

  <section class="container container--wide" aria-label="Highlights">
    <dl class="stats">
      {
        stats.map((s) => (
          <div class="stat">
            <dt>{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container container--wide block">
    <SectionHeading index="01" title="Selected work" id="work" />
    <div class="work">
      {
        work.map((w) => (
          <a class:list={['card', { 'card--media': w.image }]} href={w.href}>
            {w.image && (
              <div class="card-media">
                <img src={w.image} alt={w.alt} width="1280" height="800" loading="lazy" decoding="async" />
              </div>
            )}
            <div class="card-body">
              <p class="eyebrow">{w.kind}</p>
              <h3>{w.title}</h3>
              <p class="muted">{w.summary}</p>
              <ul class="chips">
                {w.tags.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
              <span class="more">
                Read the case study <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container container--wide block">
    <SectionHeading index="02" title="Experience" id="experience" />
    <div class="role">
      <div class="role-head">
        <div>
          <h3>Khumbu Systems</h3>
          <p class="muted">Associate Software Engineer, Backend</p>
        </div>
        <p class="mono when">2024 – present</p>
      </div>
      <ul class="prose role-list">
        {experience.map((e) => <li>{e}</li>)}
      </ul>
      <p class="role-foot">
        <a href="/about">More about me</a>
        <span class="muted" aria-hidden="true">·</span>
        <a href={site.cv}>Full CV</a>
      </p>
    </div>
  </section>

  <section class="container container--wide block">
    <SectionHeading index="03" title="Writing" id="writing" />
    <a class="post" href={site.links.article} rel="noopener">
      <p class="eyebrow">Medium · 22 June 2026</p>
      <h3>From Redis + Lettuce to Valkey GLIDE: Lessons from a Production Migration to ElastiCache Serverless</h3>
      <p class="muted">
        How we reduced cache infrastructure costs, navigated Spring lifecycle challenges, and learned what really
        happens behind a Serverless cache endpoint.
      </p>
      <span class="more">Read on Medium <span aria-hidden="true">↗</span></span>
    </a>
  </section>

  <section class="container container--wide block">
    <SectionHeading index="04" title="Contact" id="contact" />
    <p class="contact-line">
      I enjoy talking about backend and distributed systems, and the trade-offs behind the work on this site.
      I’m always open to a good conversation, and email reaches me fastest:
    </p>
    <p class="email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
    <p class="muted">
      Or find me on <a href={site.links.linkedin} rel="me">LinkedIn</a>{' '}and{' '}<a href={site.links.github} rel="me">GitHub</a>.
    </p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 3rem;
    padding-top: clamp(4rem, 12vw, 7.5rem);
    padding-bottom: 3rem;
  }

  .portrait {
    width: 280px;
    height: 280px;
    object-fit: cover;
    border-radius: 20px;
    border: 1px solid var(--rule);
    box-shadow: var(--shadow);
    background: var(--bg-sunken);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .portrait {
      order: -1;
      width: 96px;
      height: 96px;
      border-radius: 50%;
      margin-bottom: 1.5rem;
    }
  }

  .hero-text,
  .role,
  .post,
  #contact ~ p {
    max-width: var(--measure);
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    letter-spacing: -0.035em;
    line-height: 1.08;
    margin: 1rem 0 1.4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .block {
    margin-top: 5.5rem;
  }

  /* stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .stat {
    padding: 1.5rem 1.25rem 1.5rem 0;
  }

  .stat + .stat {
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }

  .stat dt {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .stat dd {
    margin: 0.35rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }

  /* work cards */
  .work {
    display: grid;
    gap: 1.25rem;
  }

  .card {
    display: grid;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--bg-raised);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    color: inherit;
    border-color: var(--rule-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .card--media {
    grid-template-columns: 1.05fr 1fr;
  }

  .card-media {
    background: var(--bg-sunken);
    border-right: 1px solid var(--rule);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    transition: transform 0.4s;
  }

  .card:hover .card-media img {
    transform: scale(1.02);
  }

  .card-body {
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
  }

  .card-body h3 {
    font-size: 1.35rem;
    margin: 0.5rem 0 0.8rem;
  }

  .card-body .muted {
    font-size: 0.97rem;
  }

  .more {
    margin-top: auto;
    padding-top: 1.2rem;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--accent-text);
  }

  .card .chips {
    margin-top: 0.2rem;
  }

  @media (max-width: 760px) {
    .card--media {
      grid-template-columns: 1fr;
    }
    .card-media {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      aspect-ratio: 16 / 10;
    }
  }

  /* experience */
  .role-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .role-head h3 {
    font-size: 1.2rem;
  }

  .role-head p {
    margin: 0.2rem 0 0;
  }

  .when {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .role-list {
    margin-top: 1.2rem;
    color: var(--text);
  }

  .role-list li {
    margin: 0.6em 0;
  }

  .role-foot {
    display: flex;
    gap: 0.6rem;
    font-size: 0.95rem;
  }

  /* writing */
  .post {
    display: block;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--bg-raised);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .post:hover {
    color: inherit;
    border-color: var(--rule-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .post h3 {
    font-size: 1.2rem;
    margin: 0.5rem 0 0.7rem;
  }

  .post .muted {
    margin-bottom: 0;
  }

  /* contact */
  .email {
    font-size: clamp(1.25rem, 4vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.2rem 0 1rem;
    overflow-wrap: anywhere;
  }

  .email a {
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }
</style>
