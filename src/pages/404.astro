---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page does not exist.">
  <section class="container nf">
    <p class="eyebrow mono">404</p>
    <h1>This page does not exist.</h1>
    <p class="muted">The link may be out of date, or the address mistyped.</p>
    <a class="btn btn--primary" href="/">Back to the home page</a>
  </section>
</Base>

<style>
  .nf {
    padding-top: clamp(4rem, 14vw, 8rem);
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    letter-spacing: -0.035em;
    margin: 0.8rem 0 1rem;
  }

  .btn {
    margin-top: 1rem;
  }
</style>
